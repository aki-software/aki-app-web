# ─────────────────────────────────────────────────────────────────
# A.kit API — Variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────

# ── Base de Datos PostgreSQL ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=REEMPLAZAR_CON_USUARIO_DB
DATABASE_PASSWORD=REEMPLAZAR_CON_PASSWORD_DB
DATABASE_NAME=example_db

# ── Autenticación y Seed Admin ────────────────────────────────────
# Credenciales del usuario administrador inicial (creado en seed y login de dashboard).
# Usar una contraseña segura de al menos 16 caracteres.
ADMIN_USER=admin@example.com
ADMIN_PASS=REEMPLAZAR_CON_PASSWORD_SEGURA
ADMIN_NAME=Platform Admin

# ── JWT ───────────────────────────────────────────────────────────
# Clave secreta para firmar los tokens JWT.
# Generar con: openssl rand -base64 64
JWT_SECRET=REEMPLAZAR_CON_SECRET_ALEATORIO_MINIMO_32_CHARS
JWT_EXPIRATION=8h
# Required to allowlist direct Firebase tokens. Use the Firebase project ID, never a token claim.
FIREBASE_PROJECT_ID=your-firebase-project-id
PUPPETEER_EXECUTABLE_PATH=/absolute/path/to/pinned/chrome
# Private Cloudflare R2 report bucket. Set credentials only in the secret manager.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=akit-private-reports
S3_REGION=auto
S3_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY
S3_SECRET_KEY=

# SMTP (Mailpit local development / Resend production)
# transport type can be "smtp" (for Mailpit) or "pro" (for Resend)
MAIL_TRANSPORT_TYPE=smtp

# Dev local: Mailpit (infra/docker/docker-compose.yml). Blank credentials disable SMTP auth.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="reports@example.com"

# Prod (Resend)
MAIL_PRO_HOST=smtp.resend.com
MAIL_PRO_PORT=465
MAIL_PRO_USER=resend
MAIL_PRO_PASS=re_your_api_key_here

# ── Payment production contract ────────────────────────────────────
# Never use PAYMENT_SIMULATION=true in production. Do not put real secrets in this file.
NODE_ENV=development
PAYMENT_SIMULATION=false
PAYMENT_GATEWAY=MERCADO_PAGO
PAYMENT_IDEMPOTENCY_SECRET=
FRONTEND_URL=https://frontend.example.com
# HTTPS origin only; no path. Webhooks use /api/v1/webhooks/payments/{stripe|mercado_pago}.
API_URL=https://api.example.com

# ── Queue / Redis ──────────────────────────────────────────────────
# Production requires distributed Redis for payment rate limiting and durable fulfillment.
# Do not rely on in-memory persistence in production.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_DB=0
REDIS_TLS=false

# ── Servidor ──────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173
WEB_APP_URL=http://localhost:5173

# ── Google Play Billing ───────────────────────────────────────────
# ANDROID_PACKAGE_NAME is obsolete. Use GOOGLE_PLAY_PACKAGE_NAME.
GOOGLE_PLAY_PACKAGE_NAME=com.example.akit
GOOGLE_PLAY_REPORT_SKU=example_report_unlock
# Base64-encoded service-account JSON. Never commit the decoded credential.
GOOGLE_PLAY_SERVICE_ACCOUNT_BASE64=REEMPLAZAR_CON_JSON_BASE64_DE_GOOGLE_PLAY_CONSOLE

# ── Payment provider secrets ───────────────────────────────────────
# Use production credentials only in the deployment secret manager; never commit real values.
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
# Stripe webhook endpoint: https://api.example.com/api/v1/webhooks/payments/stripe
MP_ACCESS_TOKEN=REPLACE_WITH_MERCADO_PAGO_ACCESS_TOKEN
MP_WEBHOOK_SECRET=REPLACE_WITH_MERCADO_PAGO_WEBHOOK_SECRET
# Mercado Pago webhook endpoint: https://api.example.com/api/v1/webhooks/payments/mercado_pago


