doctype html
-
  function immutableSubtitle(subtitle) {
    var normalized = String(subtitle || '').trim().toUpperCase();
    if (
      normalized === 'COMPETENCIAS IMPORTANTES' ||
      normalized === 'COMPETENCIAS IMPORTANTES PARA DESEMPEÑARSE EN EL ÁREA' ||
      normalized === 'LAS COMPETENCIAS MÁS IMPORTANTES PARA ESTE TIPO DE PERFIL SON'
    ) {
      return 'COMPETENCIAS IMPORTANTES PARA DESEMPEÑARSE EN EL ÁREA';
    }
    if (
      normalized === 'PROFESIONES TÉCNICAS O FORMALES' ||
      normalized === 'ALGUNAS PROFESIONES VINCULADAS' ||
      normalized === 'PUEDE INCLUIR PROFESIONES TÉCNICAS Y FORMALES' ||
      normalized === 'TAMBIÉN PUEDE INCLUIR PROFESIONES MÁS TÉCNICAS O FORMALES COMO'
    ) {
      return 'TAMBIÉN PUEDE INCLUIR PROFESIONES MÁS TÉCNICAS O FORMALES COMO';
    }
    if (
      normalized === 'OCUPACIONES Y OFICIOS' ||
      normalized === 'POSIBLES ÁMBITOS DE TRABAJO' ||
      normalized === 'ALGUNAS OCUPACIONES QUE SE VINCULAR AL ÁREA'
    ) {
      return 'ALGUNAS OCUPACIONES QUE SE VINCULAR AL ÁREA';
    }
    return String(subtitle || '').toUpperCase();
  }
mixin categoryIcon(categoryId)
  -
    var ICONS = {
      ART: '<path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>',
      SCI: '<path d="M16 3v5m-4-5v5M8 3v5m-4 13h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2z"/>',
      MECH: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
      LEAD: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
      HUM: '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>',
      SERV: '<path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"/>',
      PROT: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
      PHYS: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
      IND: '<rect x="4" y="2" width="16" height="20" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/>',
      NAT: '<path d="M11 20A7 7 0 0 1 9.8 6.9C15.5 4.9 17 3.5 19 2c1 2 2 4.5 2 8 0 5.5-4.78 10-10 10z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
      SAL: '<polyline points="23 6 13.5 14.5 8 9.5 1 16"/><polyline points="17 6 23 6 23 12"/>',
      BUS: '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',
    };
    var DEFAULT = '<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y2="8" x2="12.01" y1="8"/>';
  svg.category-icon(viewBox="0 0 24 24")
    != ICONS[categoryId] || DEFAULT

html(lang="es")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Informe Vocacional - Orient A.ki
    style(type='text/css')!= fontFaceCss
    style.

      * { box-sizing: border-box; }
      body {
        margin: 0;
        padding: 0;
        font-family: 'Inter';
        color: #{colors.text.secondary};
        background: #{colors.background.light};
        font-size: 13px;
        line-height: 1.5;
        text-transform: uppercase;
      }
      h1, h2, h3, h4 {
        letter-spacing: -0.02em;
        color: #{colors.text.primary};
        margin: 0;
      }
      ul, ol, p {
        margin: 0 0 8px 0;
      }
      .page {
        max-width: 850px;
        margin: 0 auto;
        padding: 0;
      }
      .header {
        text-align: center;
        padding: 4px 0 12px;
        border-bottom: 1px solid #{colors.surface.variantLight};
      }
      .logo-lg {
        width: 100px;
        height: auto;
        display: inline-block;
      }
      .intro {
        text-align: center;
        margin: 16px 0 14px;
      }
      .patient-name {
        font-size: 22px;
        font-weight: 900;
        color: #{colors.text.primary};
        margin: 4px 0 2px;
        letter-spacing: -0.03em;
        text-transform: uppercase;
      }
      .patient-email {
        font-size: 10px;
        color: #{colors.outline.light};
        margin-top: 0;
        font-weight: 500;
        opacity: 0.8;
      }
      .greeting {
        font-size: 14px;
        color: #{colors.primary.DEFAULT};
        margin: 0;
        font-weight: 800;
      }
      .disclaimer {
        margin: 8px 0 14px;
        padding: 10px 14px;
        border-left: 3px solid #{colors.primary.DEFAULT};
        background: #{colors.surface.light};
      }
      .disclaimer p {
        font-size: 11px;
        line-height: 1.45;
        color: #{colors.text.secondary};
        margin: 0;
      }
      .disclaimer strong {
        color: #{colors.primary.DEFAULT};
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 0.05em;
        display: block;
        margin-bottom: 2px;
      }
      .hero {
        border-left: 5px solid #{colors.actions.confirm.DEFAULT};
        background: #{colors.primary.DEFAULT};
        padding: 16px 18px;
        color: white;
      }
      .hero-title {
        font-size: 17px;
        margin: 0 0 4px;
        font-weight: 900;
        color: white;
      }
      .hero-sub {
        font-size: 11px;
        margin: 0;
        opacity: 0.95;
        line-height: 1.5;
        color: white;
      }
      .strengths-description {
        color: #{colors.text.primary};
        font-size: 12px;
        line-height: 1.5;
      }
      .pill {
        display: inline-block;
        padding: 6px 12px;
        background: #{colors.actions.confirm.DEFAULT};
        border: 1px solid #{colors.actions.confirm.DEFAULT};
        border-radius: 10px;
        font-weight: 800;
        color: white;
        font-size: 11px;
        margin-top: 12px;
      }
      .meta-row {
        margin-top: 14px;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .meta-chip {
        padding: 4px 8px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.15);
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 9px;
      }
      .holland-bars {
        margin-top: 12px;
      }
      .holland-bar-item {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 11px;
        color: white;
      }
      .holland-label {
        width: 120px;
        text-align: right;
        font-weight: 700;
      }
      .holland-bar-track {
        flex: 1;
        height: 6px;
        background: rgba(255,255,255,0.15);
        border-radius: 999px;
        overflow: hidden;
      }
      .holland-bar-fill {
        height: 100%;
        background: #{colors.primary.DEFAULT};
        border-radius: 999px;
      }
      .holland-pct {
        width: 35px;
        text-align: right;
        font-weight: 700;
        color: white;
      }
      .strengths-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }
      .strength-badge {
        padding: 4px 8px;
        background: #f5f5f4;
        border: 1px solid #{colors.surface.variantLight};
        border-radius: 6px;
        color: #{colors.primary.DEFAULT};
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .category-icon {
        width: 22px;
        height: 22px;
        stroke: #{colors.actions.confirm.DEFAULT};
        stroke-width: 2.5;
        fill: none;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      .section {
        margin-top: 28px;
      }
      .section-title {
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        color: #{colors.primary.DEFAULT};
        letter-spacing: 0.1em;
        margin-bottom: 12px;
        break-after: avoid;
        page-break-after: avoid;
      }
      .card {
        border: 1px solid #{colors.surface.variantLight};
        border-radius: 8px;
        background: #ffffff;
        padding: 12px 16px;
        box-shadow: 0 2px 6px rgba(31, 37, 35, 0.05);
      }
      .area-card {
        margin-bottom: 20px;
        border: 1px solid #{colors.surface.variantLight};
        border-radius: 8px;
        background: #ffffff;
        overflow: visible;
        break-inside: auto;
        page-break-inside: auto;
      }
      .area-head {
        padding: 12px 16px;
        background: #{colors.surface.light};
        border-bottom: 1px solid #{colors.surface.variantLight};
        display: flex;
        justify-content: space-between;
        align-items: center;
        break-after: avoid;
        page-break-after: avoid;
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .area-head h3 {
        font-size: 14px;
        font-weight: 800;
        color: #{colors.text.primary};
      }
      .badge {
        padding: 3px 8px;
        border-radius: 999px;
        background: #{colors.primary.DEFAULT}15;
        color: #{colors.primary.DEFAULT};
        font-size: 12px;
        font-weight: 800;
      }
      .area-content {
        padding: 16px;
      }
      .content-block {
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .content-block + .content-block {
        margin-top: 12px;
      }
      .block-title {
        font-size: 13px;
        color: #{colors.primary.DEFAULT};
        text-transform: uppercase;
        letter-spacing: .05em;
        font-weight: 800;
        margin-bottom: 6px;
        break-after: avoid;
        page-break-after: avoid;
      }
      .area-content ul, .triplet ul, .custom-html-content ul {
        padding-left: 20px;
        font-size: 12px;
        line-height: 1.6;
        color: #{colors.text.secondary};
        margin-bottom: 12px;
      }
      .area-content li, .triplet li, .custom-html-content li {
        margin-bottom: 4px;
      }
      .ranking-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .ranking-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid #{colors.surface.variantLight};
        page-break-inside: avoid;
      }
      .ranking-item:last-child {
        border-bottom: 0;
      }
      .ranking-label {
        font-size: 12px;
        font-weight: 700;
        color: #1d1914;
        min-width: 140px;
      }
      .ranking-bar {
        height: 10px;
        background: #ded8cc;
        border: 1px solid #d2cabb;
        border-radius: 999px;
        overflow: hidden;
        flex: 1;
      }
      .ranking-bar-fill {
        display: block;
        height: 100%;
        background: #{colors.primary.DEFAULT};
        border-radius: 999px;
      }
      .ranking-value {
        font-size: 12px;
        font-weight: 700;
        color: #{colors.actions.confirm.DEFAULT};
        min-width: 40px;
        text-align: right;
      }
      .block-text, .custom-html-content p, .custom-html-content, .custom-html-content div, .custom-html-content span {
        font-size: 12px;
        line-height: 1.6;
        color: #{colors.text.secondary};
        margin-bottom: 12px;
        font-family: 'Inter';
        font-weight: 400;
      }
      .careers-card {
        margin-top: 12px;
        border: 1px solid #{colors.surface.variantLight};
        border-radius: 10px;
        background: #{colors.surface.light};
        padding: 12px 16px;
      }
      .careers-card h4 {
        color: #{colors.actions.confirm.DEFAULT};
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 8px;
        break-after: avoid;
        page-break-after: avoid;
      }
      .careers-card ul {
        margin-bottom: 0;
      }
      .triplet {
        margin-top: 16px;
        border: 1px solid #{colors.surface.variantLight};
        border-top: 4px solid #{colors.primary.DEFAULT};
        border-radius: 8px;
        background: #ffffff;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(31, 37, 35, 0.05);
        page-break-inside: auto;
      }
      .triplet-intro {
        font-size: 12px;
        line-height: 1.6;
        color: #{colors.text.secondary};
        margin: 0 0 16px;
      }
      .key-insight {
        margin-top: 18px;
        padding: 18px 20px;
        background: #{colors.primary.DEFAULT}18;
        border-left: 5px solid #{colors.primary.DEFAULT};
        page-break-inside: avoid;
      }
      .key-insight-label {
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #{colors.primary.DEFAULT};
        margin-bottom: 6px;
      }
      .key-insight-text {
        font-size: 14px;
        line-height: 1.6;
        color: #{colors.text.primary};
        font-family: 'Inter';
        font-weight: 600;
        margin: 0;
      }
      .final-disclaimer {
        margin-top: 32px;
        padding: 24px;
        background: #ffffff;
        border: 1px solid #{colors.primary.DEFAULT};
        border-top: 4px solid #{colors.primary.DEFAULT};
        text-align: center;
        page-break-inside: avoid;
      }
      .final-disclaimer h4 {
        color: #{colors.primary.DEFAULT};
        font-size: 16px;
        font-weight: 900;
        letter-spacing: 0.08em;
        margin-bottom: 12px;
      }
      .final-disclaimer p {
        font-size: 14px;
        line-height: 1.6;
        color: #{colors.text.primary};
        font-weight: 500;
        margin-bottom: 8px;
      }
      .triplet h3 {
        color: #{colors.actions.confirm.DEFAULT};
        font-size: 14px;
        font-weight: 800;
        letter-spacing: -0.01em;
        margin-bottom: 12px;
        break-after: avoid;
        page-break-after: avoid;
      }
      .footer {
        margin-top: 40px;
        padding: 16px 8px;
        border-top: 1px solid #{colors.surface.variantLight};
        text-align: center;
        color: #{colors.outline.light};
        font-size: 10px;
      }
  body
    .page
      .header
        if logoDataUri
          img.logo-lg(src=logoDataUri alt="Orient A.ki")

      .intro
        p.greeting ¡Hola!
        h1.patient-name #{patientName.toUpperCase()}
        if patientEmail
          p.patient-email #{patientEmail}

      .disclaimer
        p <strong>IMPORTANTE</strong> Conocer tus intereses no significa definir un único trabajo para toda la vida, sino orientarte para tomar decisiones más conscientes, elegir mejor tus próximos pasos (estudio, cursos, búsquedas de empleo) y reconocer en qué áreas puedes aportar mayor valor y encontrar satisfacción profesional.

      .hero
        h1.hero-title Ranking de Afinidad
        p.hero-sub Tu perfil ordenado por nivel de afinidad, de mayor a menor.

        if summary && summary.rankedAreas && summary.rankedAreas.length > 0
          .holland-bars(style="margin-top: 16px;")
            each area, index in summary.rankedAreas
              .holland-bar-item
                span.holland-label(style="width:120px;") #{index + 1}. #{area.title}
                .holland-bar-track
                  .holland-bar-fill(style=`width:${area.percentage}%; background:#ffffff;`)
                span.holland-pct #{area.percentage}%

        .meta-row(style="margin-top: 20px;")
          .meta-chip Informe ocupacional
          .meta-chip #{brandDomain}


      if bottomAreas && bottomAreas.length > 0
        .section
          p.section-title Áreas menos seleccionadas
          .card
            ul.ranking-list
              each area in bottomAreas
                li.ranking-item
                  span.ranking-label #{area.title}
                  span.ranking-bar
                    span.ranking-bar-fill(style=`width:${area.percentage}%`)
                  span.ranking-value #{area.percentage}%


      .section
        p.section-title Análisis de áreas de afinidad
        each res in topResults
          .area-card
            .area-head
              div(style="display: flex; align-items: center; gap: 10px;")
                +categoryIcon(res.categoryId)
                h3 #{res.title || 'Área sin identificar'}
              if res.percentage
                .badge #{res.percentage}%
            .area-content
              if res.parsedBlocks && res.parsedBlocks.length > 0
                each block in res.parsedBlocks
                  .content-block
                    if block.subtitle
                      p.block-title #{immutableSubtitle(block.subtitle)}
                    if block.list
                      ul
                        each item in block.list
                          li #{item}
                    else if block.content
                      p.block-text #{block.content}
              else
                .content-block
                  p.block-text #{res.description}

      if tripletInsight
        .section
          p.section-title ¿Qué significa la combinación de estas áreas?
          .triplet
            p.triplet-intro Lo más importante no es cada área por separado, sino cómo se combinan entre sí. En tu caso, la combinación:
            h3 #{tripletInsight.title || 'Combinación de intereses'}
            if tripletInsight.narrative
              - var narrativeSentence = tripletInsight.narrative.toUpperCase()
              p.block-text(style="font-size:12px;line-height:1.65;color:#{colors.text.secondary};margin-bottom:12px;font-family:'Inter';font-weight:400;") #{narrativeSentence}
            - var competencies = tripletInsight.competencies && tripletInsight.competencies.length > 0 ? tripletInsight.competencies : tripletInsight.tendencies
            if competencies && competencies.length > 0
              p.block-title COMPETENCIAS IMPORTANTES PARA DESEMPEÑARSE EN EL ÁREA
              ul
                each competency in competencies
                  li #{competency}
            if tripletInsight.possibleJobs && tripletInsight.possibleJobs.length > 0
              p.block-title ALGUNAS OCUPACIONES QUE SE VINCULAR AL ÁREA
              ul
                each job in tripletInsight.possibleJobs
                  li #{job}
            if tripletInsight.relatedProfessions && tripletInsight.relatedProfessions.length > 0
              p.block-title TAMBIÉN PUEDE INCLUIR PROFESIONES MÁS TÉCNICAS O FORMALES COMO
              ul
                each profession in tripletInsight.relatedProfessions
                  li #{profession}
            if tripletInsight.keyInsight
              - var keyInsightSentence = tripletInsight.keyInsight.toUpperCase()
              .key-insight
                p.key-insight-label La clave en esta combinación
                p.key-insight-text #{keyInsightSentence}
            if tripletInsight.customSections && tripletInsight.customSections.length > 0
              each section in tripletInsight.customSections
                if section.title
                  p.block-title #{immutableSubtitle(section.title)}
                if section.items && section.items.length > 0
                  ul
                    each item in section.items
                      li #{item}



      .final-disclaimer
        h4 Orient A.ki
        p Tomar una decisión es un proceso de elegir una opción entre varias. Orient A.ki te presenta posibilidades para andamiar esa decisión.
        p Si deseas realizar el proceso Ocupacional y ampliar la información, comunícate con Orient A.ki y te brindaremos apoyo profesional.
        div(style="margin-top: 16px;")
          a(href=`mailto:${supportEmail}` style="display:inline-block;padding:10px 24px;background:#{colors.primary.DEFAULT};color:#ffffff;text-decoration:none;border-radius:999px;font-size:13px;font-weight:700;letter-spacing:0.02em;") Contactar a Orient A.ki

      .footer
        p(style="margin:0 0 4px;") Orient A.ki - Orientacion vocacional
        div(style="margin-top: 6px;")
          p(style="margin:0; opacity: 0.8;") #{supportEmail}
          p(style="margin:2px 0 0; font-weight: 700;") #{brandDomain}
        p(style="margin-top: 6px; font-style: italic;") Documento reservado para fines orientativos
