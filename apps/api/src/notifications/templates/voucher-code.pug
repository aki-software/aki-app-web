extends ./base-email.pug

block bodyContent
  tr
    td(style="padding:8px 40px;")
      h1.text-primary(style=`margin:0 0 16px 0;font-size:24px;font-weight:800;letter-spacing:-0.02em;line-height:1.3;color:${colors.primary.DEFAULT};`) Tu código de acceso
      if patientName
        p(style=`margin:0 0 12px 0;font-size:15px;color:${colors.text.secondary};line-height:1.6;`)
          | Hola 
          strong(style=`color:${colors.text.primary};font-weight:700;`) #{patientName}
          | ,
      else
        p(style=`margin:0 0 12px 0;font-size:15px;color:${colors.text.secondary};line-height:1.6;`) Hola,
      
      p(style=`margin:0 0 24px 0;font-size:15px;line-height:1.6;color:${colors.text.secondary};`)
        | Has recibido un pase libre para el test vocacional de A.ki
        if institutionName
          |  otorgado por 
          strong(style=`color:${colors.text.primary};font-weight:700;`) #{institutionName}
        | . Ingresá el siguiente código en la aplicación para comenzar:

  tr
    td(style="padding:0 40px 32px;")
      table(role="presentation" width="100%" cellpadding="0" cellspacing="0" style=`background-color:${colors.background.light};border-radius:16px;border:1px solid ${colors.surface.variantLight};`)
        tr
          td(style="padding:32px 24px;text-align:center;")
            p(style=`margin:0 0 12px 0;font-size:12px;text-transform:uppercase;letter-spacing:0.16em;font-weight:700;color:${colors.outline.light};`) Código de acceso
            div(style=`display:inline-block;padding:16px 32px;background-color:${colors.surface.light};border:2px dashed ${colors.primary.DEFAULT};border-radius:12px;`)
              span(style=`font-size:28px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-weight:800;letter-spacing:0.15em;color:${colors.primary.DEFAULT};`) #{voucherCode}
