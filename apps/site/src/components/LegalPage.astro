---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import type { Locale, Translation } from '../i18n/translations';
import {
  legalContent,
  CONTACT_EMAIL,
  WHATSAPP_DISPLAY,
  buildWhatsAppUrl,
  type LegalDocumentContent,
} from '../i18n/legal';

interface Props {
  locale: Locale;
  t: Translation;
  docKey: 'privacy' | 'terms' | 'deleteAccount';
}

const { locale, t, docKey } = Astro.props;
const docs = legalContent[locale];
const doc: LegalDocumentContent = docs[docKey];

const prefix = locale === 'en' ? '/en' : '';
const navItems = [
  { key: 'privacy', label: t.footer.privacy, href: `${prefix}/privacidad` },
  { key: 'terms', label: t.footer.terms, href: `${prefix}/terminos` },
  { key: 'deleteAccount', label: t.footer.deleteAccount, href: `${prefix}/borrar-cuenta` },
] as const;

const mailtoHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(doc.contactBox.emailSubject)}`;
const whatsappHref = buildWhatsAppUrl(doc.contactBox.whatsappText);
const backHomeLabel = locale === 'en' ? 'Back to home' : 'Volver al inicio';
const homeHref = locale === 'en' ? '/en' : '/';
---

<BaseLayout
  locale={locale}
  t={t}
  title={`${doc.title} — ORIENT A.KI`}
  description={doc.subtitle}
>
  <Navbar locale={locale} t={t} />

  <main id="main" class="min-h-screen bg-bg">
    <!-- Dark header so fixed Navbar remains high-contrast and transitions cleanly on scroll -->
    <section id="hero" class="relative bg-dark-bg pt-32 pb-16 md:pt-36 md:pb-20 border-b border-white/10">
      <div class="container relative z-10">
        <div class="max-w-3xl">
          <a
            href={homeHref}
            class="inline-flex items-center gap-2 text-sm font-medium text-dark-muted hover:text-white transition-colors mb-6"
          >
            <svg aria-hidden="true" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>{backHomeLabel}</span>
          </a>

          <h1 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight leading-tight">
            {doc.title}
          </h1>

          <p class="mt-4 text-base sm:text-lg text-dark-muted leading-relaxed max-w-[68ch]">
            {doc.subtitle}
          </p>

          <p class="mt-4 text-xs sm:text-sm text-white/60 font-medium">
            {doc.updatedAt}
          </p>

          <!-- Document switcher -->
          <nav
            aria-label={doc.quickNavLabel}
            class="mt-8 flex flex-wrap items-center gap-2.5"
          >
            {navItems.map((item) => {
              const isActive = item.key === docKey;
              return (
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-colors',
                    isActive
                      ? 'bg-primary text-white'
                      : 'bg-white/5 text-dark-muted hover:bg-white/10 hover:text-white border border-white/10',
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>
        </div>
      </div>
    </section>

    <!-- Main reading surface -->
    <section class="py-12 md:py-20">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-8 lg:gap-12 items-start">
          <!-- Table of contents sidebar -->
          <aside class="lg:sticky lg:top-28 bg-surface rounded-2xl border border-border/70 p-5 sm:p-6">
            <h2 class="font-display font-bold text-sm text-text mb-3">
              {doc.tocTitle}
            </h2>
            <ol class="space-y-2">
              {doc.sections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="block text-xs sm:text-sm text-text-muted hover:text-primary transition-colors leading-snug py-1 break-words"
                  >
                    {section.title}
                  </a>
                </li>
              ))}
            </ol>
          </aside>

          <!-- Document article -->
          <article
            id="legal-article"
            class="bg-surface rounded-2xl border border-border/70 p-6 sm:p-10 md:p-12 min-w-0"
          >
            <div class="max-w-[70ch] space-y-10">
              {doc.sections.map((section) => (
                <section id={section.id} class="scroll-mt-28">
                  <h2 class="font-display font-bold text-xl sm:text-2xl text-text tracking-tight mb-4">
                    {section.title}
                  </h2>

                  <div class="space-y-4 text-base text-text/90 leading-relaxed break-words">
                    {section.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>

                  {section.bullets && section.bullets.length > 0 && (
                    <ul class="mt-4 space-y-3 text-base text-text/90 leading-relaxed">
                      {section.bullets.map((bullet) => (
                        <li class="flex items-start gap-3">
                          <span
                            aria-hidden="true"
                            class="mt-2 w-1.5 h-1.5 rounded-full bg-primary shrink-0"
                          />
                          <span class="min-w-0 break-words">{bullet}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              ))}
            </div>

            <!-- Action & Contact Box -->
            <div class="mt-12 pt-8 border-t border-border/70 max-w-[70ch]">
              <div class="bg-bg rounded-2xl border border-border/80 p-6 sm:p-8">
                <h2 class="font-display font-bold text-lg sm:text-xl text-text">
                  {doc.contactBox.title}
                </h2>
                <p class="mt-2 text-sm sm:text-base text-text-muted leading-relaxed">
                  {doc.contactBox.description}
                </p>

                <div class="mt-6 flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3">
                  <a
                    href={mailtoHref}
                    class="inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl bg-primary text-white text-sm font-bold hover:bg-primary-dark transition-colors"
                  >
                    <svg aria-hidden="true" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span>{doc.contactBox.emailLabel}</span>
                  </a>

                  <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-2.5 px-5 py-3 rounded-xl bg-surface text-text border border-border hover:border-primary hover:text-primary text-sm font-semibold transition-colors"
                  >
                    <svg aria-hidden="true" class="w-4 h-4 shrink-0 text-confirm" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
                    </svg>
                    <span>{doc.contactBox.whatsappLabel} ({WHATSAPP_DISPLAY})</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <Footer locale={locale} t={t} />
</BaseLayout>
