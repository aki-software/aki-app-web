---
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: Translation;
}

const { locale, t } = Astro.props;
const isEn = locale === 'en';
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || 'https://formsubmit.co/contacto@orientaki.com';
---

<section class="bg-surface rounded-3xl border border-border/60 shadow-md p-8 sm:p-10 max-w-xl mx-auto reveal">
  <h3 class="font-display font-bold text-2xl text-text mb-6 text-center">
    {isEn ? 'Request an institutional demo' : 'Solicitá una demo institucional'}
  </h3>

  <form action={formEndpoint || '#'} method="POST" class="flex flex-col gap-4" id="contact-form">
    <input type="hidden" name="_captcha" value="false">
    <input type="hidden" name="_template" value="table">
    <input type="hidden" name="_subject" value="Nueva Solicitud de Demo / Plan Institucional">
    <input type="hidden" name="selected_plan" id="selected-plan-input" value="" />
    <div>
      <label for="contact-name" class="block text-xs font-semibold text-text uppercase tracking-wider mb-1.5">{t.institutions.form.name}</label>
      <input type="text" id="contact-name" name="name" required placeholder={isEn ? "Your name" : "Tu nombre"} class="w-full px-4 py-3 rounded-xl border border-border bg-bg text-text text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
    </div>
    <div>
      <label for="contact-email" class="block text-xs font-semibold text-text uppercase tracking-wider mb-1.5">{t.institutions.form.email}</label>
      <input type="email" id="contact-email" name="email" required placeholder="correo@institucion.edu" class="w-full px-4 py-3 rounded-xl border border-border bg-bg text-text text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
    </div>
    <div>
      <label for="contact-institution" class="block text-xs font-semibold text-text uppercase tracking-wider mb-1.5">{t.institutions.form.institution}</label>
      <input type="text" id="contact-institution" name="institution" placeholder={isEn ? "School / Organization" : "Colegio / Consultorio / Organización"} class="w-full px-4 py-3 rounded-xl border border-border bg-bg text-text text-sm focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all" />
    </div>
    <button type="submit" id="contact-submit-btn" class="w-full py-4 text-sm font-bold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all hover:scale-[1.01] shadow-sm cursor-pointer mt-2">
      {t.institutions.form.submit}
    </button>
    <div id="form-success" class="p-4 rounded-xl bg-primary/10 border border-primary/30 text-primary text-sm font-medium text-center hidden" role="alert">
      <p class="font-bold mb-1">✓ {isEn ? 'Request received' : 'Solicitud recibida'}</p>
      <p>{t.institutions.form.success}</p>
    </div>
  </form>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');
  const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;
  const planInput = document.getElementById('selected-plan-input') as HTMLInputElement | null;
  const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;

  // Listen for plan selection from Pricing section
  window.addEventListener('akit:select-plan', ((e: CustomEvent) => {
    const plan = e.detail?.plan;
    if (planInput) planInput.value = plan || '';
    nameInput?.focus();
  }) as EventListener);

  if (form && success) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.getAttribute('action');
      const data = new FormData(form);

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
      }

      if (endpoint && endpoint !== '#') {
        const payload = {
          name: data.get('name'),
          email: data.get('email'),
          institution: data.get('institution'),
          selected_plan: data.get('selected_plan') || 'General'
        };

        try {
          const response = await fetch(endpoint, { 
            method: 'POST', 
            body: JSON.stringify(payload), 
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' } 
          });
          
          if (!response.ok) throw new Error('API Error');
          
          form.reset();
          success.classList.remove('hidden');
        } catch (_) {
          fallbackMailto(data);
        }
      } else {
        fallbackMailto(data);
      }

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }
    });

    function fallbackMailto(data: FormData) {
      const name = data.get('name') || '';
      const email = data.get('email') || '';
      const institution = data.get('institution') || '';
      const plan = data.get('selected_plan') || 'General';
      
      const subject = encodeURIComponent(`Solicitud de Demo - ${institution}`);
      const body = encodeURIComponent(`Nombre: ${name}\nEmail: ${email}\nInstitución: ${institution}\nPlan interesado: ${plan}\n\nHola, me gustaría solicitar una demo institucional de Orient A.KI.`);
      
      window.location.href = `mailto:contacto@orientaki.com?subject=${subject}&body=${body}`;
      
      setTimeout(() => {
        form?.reset();
        success?.classList.remove('hidden');
      }, 500);
    }
  }
</script>