---
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: Translation;
}

const { t } = Astro.props;
---

<section class="py-24 md:py-32 relative bg-bg" id="precios">

  <div class="container">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface border border-secondary/20 mb-6 reveal shadow-sm">
        <p class="text-[11px] font-medium text-secondary tracking-widest uppercase">
          PLANES CLAROS
        </p>
      </div>
      <h2 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-text mb-6 reveal reveal-delay-1 tracking-tight">{t.pricing.title}</h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto reveal reveal-delay-2">{t.pricing.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8 max-w-7xl mx-auto">
      <!-- Demo Tier -->
      <div class="flex flex-col bg-surface border-2 border-primary/40 rounded-[2rem] p-8 reveal hover:-translate-y-1 transition-transform duration-500 shadow-md">
        <div class="mb-8">
          <div class="flex justify-between items-center mb-4">
            <p class="text-sm font-semibold text-text-muted uppercase tracking-widest flex items-center gap-1" set:html={t.pricing.demo.label}></p>
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white bg-primary rounded-full">{t.pricing.demo.badge}</span>
          </div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="font-display font-bold text-3xl text-text">{t.pricing.demo.price}</span>
          </div>
          <p class="text-xs text-text-muted font-medium">{t.pricing.demo.desc}</p>
        </div>
        
        <div class="flex-1 flex flex-col gap-4 mb-8">
          {t.pricing.demo.features.map((f) => (
            <div class="flex items-start gap-3">
              <div class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-sm text-text/80 leading-relaxed">{f}</span>
            </div>
          ))}
        </div>

        <a href="#instituciones" data-plan="demo" class="plan-cta mt-auto block w-full py-4 text-center text-sm font-bold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all hover:scale-[1.02] shadow-sm">{t.pricing.demo.cta}</a>
      </div>

      <!-- Basic Tier -->
      <div class="flex flex-col bg-surface border border-border/60 rounded-[2rem] p-8 reveal reveal-delay-1 hover:-translate-y-1 transition-transform duration-500 shadow-sm">
        <div class="mb-8">
          <div class="flex justify-between items-center mb-4">
            <p class="text-sm font-semibold text-text uppercase tracking-widest flex items-center gap-1" set:html={t.pricing.basic.label}></p>
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white bg-secondary rounded-full">{t.pricing.basic.badge}</span>
          </div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="font-display font-bold text-3xl text-text">{t.pricing.basic.price}</span>
          </div>
          <p class="text-xs text-text-muted font-medium">{t.pricing.basic.desc}</p>
        </div>
        
        <div class="flex-1 flex flex-col gap-4 mb-8">
          {t.pricing.basic.features.map((f) => (
            <div class="flex items-start gap-3">
              <div class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-sm text-text leading-relaxed">{f}</span>
            </div>
          ))}
        </div>

        <a href="#instituciones" data-plan="basic" class="plan-cta mt-auto block w-full py-4 text-center text-sm font-bold text-bg bg-text rounded-xl hover:opacity-90 transition-all hover:scale-[1.02]">{t.pricing.basic.cta}</a>
      </div>

      <!-- Pro Tier -->
      <div class="flex flex-col bg-surface border border-border/60 rounded-[2rem] p-8 reveal reveal-delay-2 hover:-translate-y-1 transition-transform duration-500 shadow-sm">
        <div class="mb-8">
          <div class="flex justify-between items-center mb-4">
            <p class="text-sm font-semibold text-text uppercase tracking-widest flex items-center gap-1" set:html={t.pricing.pro.label}></p>
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white bg-primary rounded-full">{t.pricing.pro.badge}</span>
          </div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="font-display font-bold text-3xl text-text">{t.pricing.pro.price}</span>
          </div>
          <p class="text-xs text-text-muted font-medium">{t.pricing.pro.desc}</p>
        </div>
        
        <div class="flex-1 flex flex-col gap-4 mb-8">
          {t.pricing.pro.features.map((f) => (
            <div class="flex items-start gap-3">
              <div class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center">
                <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-sm text-text leading-relaxed">{f}</span>
            </div>
          ))}
        </div>

        <a href="#instituciones" data-plan="pro" class="plan-cta mt-auto block w-full py-4 text-center text-sm font-bold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all hover:scale-[1.02]">{t.pricing.pro.cta}</a>
      </div>

      <!-- Enterprise Tier -->
      <div class="flex flex-col bg-surface border-2 border-text rounded-[2rem] p-8 reveal reveal-delay-3 hover:-translate-y-1 transition-transform duration-500 shadow-md">
        <div class="mb-8">
          <div class="flex justify-between items-center mb-4">
            <p class="text-sm font-semibold text-text uppercase tracking-widest flex items-center gap-1" set:html={t.pricing.enterprise.label}></p>
            <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-bg bg-text rounded-full">{t.pricing.enterprise.badge}</span>
          </div>
          <div class="flex items-baseline gap-1 mb-2">
            <span class="font-display font-bold text-3xl text-text">{t.pricing.enterprise.price}</span>
          </div>
          <p class="text-xs text-text-muted font-medium">{t.pricing.enterprise.desc}</p>
        </div>
        
        <div class="flex-1 flex flex-col gap-4 mb-8">
          {t.pricing.enterprise.features.map((f) => (
            <div class="flex items-start gap-3">
              <div class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-text/10 border border-text/20 flex items-center justify-center">
                <svg class="w-3 h-3 text-text" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </div>
              <span class="text-sm text-text leading-relaxed">{f}</span>
            </div>
          ))}
        </div>

        <a href="#instituciones" data-plan="enterprise" class="plan-cta mt-auto block w-full py-4 text-center text-sm font-bold text-bg bg-text rounded-xl hover:opacity-90 transition-all hover:scale-[1.02]">{t.pricing.enterprise.cta}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Plan selection link handler
  document.querySelectorAll<HTMLAnchorElement>('.plan-cta').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const plan = btn.dataset.plan;
      const target = document.getElementById('instituciones');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
      
      // Dispatch custom event to notify ContactForm
      window.dispatchEvent(new CustomEvent('akit:select-plan', { detail: { plan } }));
    });
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>