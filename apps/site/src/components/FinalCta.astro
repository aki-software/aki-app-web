---
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: Translation;
}

const { t } = Astro.props;
const playStoreUrl = import.meta.env.PUBLIC_PLAY_STORE_URL || 'https://play.google.com/store/apps/details?id=com.akit.app';
---

<section class="py-24 md:py-32 bg-surface border-t border-border/50 text-center" id="cta-final">
  <div class="container">
    <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-4 text-text reveal">{t.finalCta.title}</h2>
    <p class="text-text-muted mb-8 max-w-md mx-auto reveal reveal-delay-1">{t.finalCta.subtitle}</p>

    <a href="#instituciones" data-access-cta class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-primary rounded-xl hover:bg-primary-dark transition-colors">{t.hero.ctaPrimary}</a>
    <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="block w-fit mx-auto mt-6 py-3 text-sm text-text-muted underline underline-offset-4">{t.finalCta.googlePlay}</a>
  </div>
</section>

<!-- Sticky mobile CTA (auto-hidden when #instituciones form is visible) -->
<div id="sticky-mobile-cta" class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-bg/95 backdrop-blur-md border-t border-border/60 p-3 shadow-lg transition-transform duration-300">
  <a href="#instituciones" data-access-cta class="flex items-center justify-center w-full py-3.5 text-sm font-bold text-white bg-primary rounded-xl">{t.hero.ctaPrimary}</a>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('#cta-final .reveal').forEach((el) => observer.observe(el));

  const stickyCta = document.getElementById('sticky-mobile-cta');
  const formSection = document.getElementById('instituciones');
  if (stickyCta && formSection) {
    const formObserver = new IntersectionObserver(([entry]) => {
      stickyCta.classList.toggle('translate-y-full', entry.isIntersecting);
      stickyCta.classList.toggle('pointer-events-none', entry.isIntersecting);
    }, { threshold: 0.15 });
    formObserver.observe(formSection);
  }
</script>
