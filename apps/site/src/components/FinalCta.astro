---
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: Translation;
}

const { t } = Astro.props;
const playStoreUrl = import.meta.env.PUBLIC_PLAY_STORE_URL || 'https://play.google.com/store/apps/details?id=com.akit.app';
---

<section class="py-24 md:py-32 bg-bg text-center" id="cta-final">
  <div class="container">
    <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl mb-4 text-text reveal">{t.finalCta.title}</h2>
    <p class="text-text-muted mb-8 max-w-md mx-auto reveal reveal-delay-1">{t.finalCta.subtitle}</p>

    <div class="max-w-md mx-auto bg-surface border border-border/80 rounded-3xl p-8 shadow-md mt-10 reveal reveal-delay-2 flex flex-col items-center">
      <div class="w-36 h-36 bg-white p-3 rounded-2xl shadow-inner border border-border/40 flex items-center justify-center mb-5">
        <img src="/qr-playstore.png" alt={t.finalCta.qrLabel} class="w-full h-full object-contain" loading="lazy" />
      </div>

      <p class="text-base font-bold text-text mb-1">{t.finalCta.qrLabel}</p>
      <p class="text-xs text-text-muted mb-6 max-w-xs">{t.finalCta.qrSublabel}</p>

      <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 text-sm font-bold text-white bg-primary rounded-xl hover:bg-primary-dark transition-all hover:scale-[1.02] duration-300 shadow-md">
        <svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 12l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/>
        </svg>
        {t.finalCta.googlePlay}
      </a>
    </div>
  </div>
</section>

<!-- Sticky mobile CTA -->
<div class="fixed bottom-0 left-0 right-0 z-50 md:hidden bg-bg/95 backdrop-blur-md border-t border-border/60 p-3 shadow-lg">
  <a href={playStoreUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-3.5 text-sm font-bold text-white bg-primary rounded-xl shadow-md">
    <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.302 2.302a1 1 0 010 1.38l-2.302 2.302L15.396 12l2.302-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302L5.864 2.658z"/>
    </svg>
    {t.hero.ctaPrimary}
  </a>
</div>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
