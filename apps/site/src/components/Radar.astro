---
import type { Locale, Translation } from '../i18n/translations';

interface Props {
  locale: Locale;
  t: Translation;
}

const { locale, t } = Astro.props;
const categories = t.methodology.categories;

interface BadgeStyle {
  code: string;
  border: string;
  text: string;
  bg: string;
  dot: string;
}

const badgeStyles: BadgeStyle[] = [
  { code: 'ART', border: 'border-violet-200', text: 'text-violet-700', bg: 'bg-violet-50', dot: '#a78bfa' },
  { code: 'HUM', border: 'border-fuchsia-200', text: 'text-fuchsia-700', bg: 'bg-fuchsia-50', dot: '#d946ef' },
  { code: 'SERV', border: 'border-teal-200', text: 'text-teal-700', bg: 'bg-teal-50', dot: '#0d9488' },
  { code: 'PROT', border: 'border-slate-200', text: 'text-slate-700', bg: 'bg-slate-50', dot: '#64748b' },
  { code: 'FÍS', border: 'border-red-200', text: 'text-red-700', bg: 'bg-red-50', dot: '#f43f5e' },
  { code: 'IND', border: 'border-zinc-200', text: 'text-zinc-700', bg: 'bg-zinc-50', dot: '#52525b' },
  { code: 'MEC', border: 'border-orange-200', text: 'text-orange-700', bg: 'bg-orange-50', dot: '#ea580c' },
  { code: 'NAT', border: 'border-green-200', text: 'text-green-700', bg: 'bg-green-50', dot: '#22c55e' },
  { code: 'LÍD', border: 'border-indigo-200', text: 'text-indigo-700', bg: 'bg-indigo-50', dot: '#6366f1' },
  { code: locale === 'es' ? 'CIE' : 'SCI', border: 'border-indigo-300', text: 'text-indigo-800', bg: 'bg-indigo-100', dot: '#4338ca' },
  { code: 'VENT', border: 'border-red-200', text: 'text-red-700', bg: 'bg-red-50', dot: '#f43f5e' },
  { code: locale === 'es' ? 'NEG' : 'BUS', border: 'border-indigo-200', text: 'text-indigo-800', bg: 'bg-indigo-50', dot: '#312e81' },
];

const categoryDimensions = [
  { x: 50, y: 20, lx: 50, ly: 6, code: 'ART', fullName: locale === 'es' ? 'Artística' : 'Arts', color: '#7c3aed', dotColor: '#a78bfa' },
  { x: 63, y: 25, lx: 70, ly: 16, code: 'HUM', fullName: locale === 'es' ? 'Humanidades' : 'Humanities', color: '#c026d3', dotColor: '#d946ef' },
  { x: 72, y: 35, lx: 86, ly: 30, code: 'SERV', fullName: locale === 'es' ? 'Servicios y acomodación' : 'Services & Accommodation', color: '#0f766e', dotColor: '#0d9488' },
  { x: 78, y: 50, lx: 91, ly: 50, code: 'PROT', fullName: locale === 'es' ? 'Protección' : 'Protection', color: '#475569', dotColor: '#64748b' },
  { x: 72, y: 60, lx: 86, ly: 70, code: 'FÍS', fullName: locale === 'es' ? 'Deportes' : 'Sports', color: '#dc2626', dotColor: '#f43f5e' },
  { x: 62, y: 72, lx: 70, ly: 84, code: 'IND', fullName: locale === 'es' ? 'Industria' : 'Industry', color: '#525252', dotColor: '#52525b' },
  { x: 50, y: 78, lx: 50, ly: 92, code: 'MEC', fullName: locale === 'es' ? 'Mecánica' : 'Mechanics', color: '#c2410c', dotColor: '#ea580c' },
  { x: 38, y: 72, lx: 30, ly: 84, code: 'NAT', fullName: locale === 'es' ? 'Naturaleza' : 'Nature', color: '#16a34a', dotColor: '#22c55e' },
  { x: 28, y: 60, lx: 14, ly: 70, code: 'LÍD', fullName: locale === 'es' ? 'Liderazgo' : 'Leadership', color: '#4f46e5', dotColor: '#6366f1' },
  { x: 24, y: 50, lx: 9, ly: 50, code: locale === 'es' ? 'CIE' : 'SCI', fullName: locale === 'es' ? 'Ciencia' : 'Science', color: '#3730a3', dotColor: '#4338ca' },
  { x: 28, y: 38, lx: 14, ly: 30, code: 'VENT', fullName: locale === 'es' ? 'Ventas' : 'Sales', color: '#dc2626', dotColor: '#f43f5e' },
  { x: 38, y: 25, lx: 30, ly: 16, code: locale === 'es' ? 'NEG' : 'BUS', fullName: locale === 'es' ? 'Negocios' : 'Business', color: '#1e1b4b', dotColor: '#312e81' },
];
---

<section class="py-24 md:py-32 relative bg-bg overflow-hidden" id="metodologia">
  <div class="container relative z-10">
    <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
      <!-- Radar Visualization Card -->
      <div class="flex-1 relative w-full max-w-[460px] mx-auto lg:mx-0">
        <div id="radar-card" class="bg-surface border border-border/60 p-6 sm:p-8 md:p-10 rounded-[2.5rem] sm:rounded-[3rem] shadow-md overflow-hidden relative group">
          
          <!-- Floating live badge over the radar -->
          <div id="radar-floating-info" class="absolute top-4 left-6 right-6 flex items-center justify-between pointer-events-none opacity-0 translate-y-1 transition-all duration-300 z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface/95 border border-border shadow-sm backdrop-blur-md">
              <span id="radar-info-dot" class="w-2.5 h-2.5 rounded-full transition-colors duration-200"></span>
              <span id="radar-info-code" class="font-display font-bold text-xs text-text"></span>
              <span class="text-border/60">·</span>
              <span id="radar-info-name" class="text-xs text-text-muted font-medium truncate max-w-[140px] sm:max-w-none"></span>
            </div>
            <span class="hidden sm:inline-flex px-2 py-0.5 rounded-md bg-primary/10 text-primary text-[10px] font-bold tracking-wider uppercase">
              {locale === 'es' ? 'Dimensión' : 'Dimension'}
            </span>
          </div>

          <div class="radar-svg-wrapper pt-4" style="transform: scale(0.8); opacity: 0; transition: transform 1s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.6s ease;">
            <svg aria-hidden="true" viewBox="0 0 100 100" class="w-full h-auto overflow-visible select-none">
              <defs>
                <linearGradient id="radarFillRecharts" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="5%" stop-color="var(--color-primary)" stop-opacity="0.55" />
                  <stop offset="95%" stop-color="var(--color-primary)" stop-opacity="0.08" />
                </linearGradient>
                <filter id="dot-glow-recharts">
                  <feGaussianBlur stdDeviation="1" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>

              <!-- Polar grid: concentric circles at 25%, 50%, 75%, 100% -->
              <circle cx="50" cy="50" r="36" fill="none" stroke="rgba(0,0,0,0.10)" stroke-width="0.4" />
              <circle cx="50" cy="50" r="27" fill="none" stroke="rgba(0,0,0,0.06)" stroke-width="0.3" stroke-dasharray="2 2" />
              <circle cx="50" cy="50" r="18" fill="none" stroke="rgba(0,0,0,0.05)" stroke-width="0.3" stroke-dasharray="2 2" />
              <circle cx="50" cy="50" r="9" fill="none" stroke="rgba(0,0,0,0.04)" stroke-width="0.3" stroke-dasharray="1.5 1.5" />

              <!-- Radius axis lines (dashed) -->
              {[
                [50, 14], [68, 18.8], [81.2, 32], [86, 50],
                [81.2, 68], [68, 81.2], [50, 86], [32, 81.2],
                [18.8, 68], [14, 50], [18.8, 32], [32, 18.8]
              ].map(([x1, y1]) => (
                <line x1={`${x1}`} y1={`${y1}`} x2="50" y2="50" stroke="rgba(0,0,0,0.07)" stroke-width="0.3" stroke-dasharray="2 3" />
              ))}

              <!-- Radius axis labels (0, 25, 50, 75, 100) on the right axis -->
              {[
                { x: 50, y: 91, val: '0' },
                { x: 41, y: 83, val: '25' },
                { x: 32, y: 74, val: '50' },
                { x: 23, y: 65, val: '75' },
                { x: 14, y: 56, val: '100' }
              ].map(({ x, y, val }) => (
                <text x={`${x}`} y={`${y}`} text-anchor="end" fill="rgba(0,0,0,0.15)" font-size="2.2" font-weight="500" font-family="monospace">{val}</text>
              ))}

              <!-- Result polygon (animated draw) -->
              <polygon id="radar-result"
                points="50,20 63,25 72,35 78,50 72,60 62,72 50,78 38,72 28,60 24,50 28,38 38,25"
                fill="url(#radarFillRecharts)"
                stroke="var(--color-primary)"
                stroke-width="1.8"
                stroke-linejoin="round"
                stroke-dasharray="400"
                stroke-dashoffset="400"
                filter="url(#dot-glow-recharts)"
              />

              <!-- Vertex dots with generous hit-targets for bidirectional hover -->
              {categoryDimensions.map(({ x, y, dotColor, code, fullName }) => (
                <g
                  class="radar-interactive-target cursor-pointer"
                  data-code={code}
                  data-fullname={fullName}
                  data-color={dotColor}
                  tabindex="0"
                  role="button"
                  aria-label={`Categoría ${code}: ${fullName}`}
                >
                  <circle cx={`${x}`} cy={`${y}`} r="7" fill="transparent" class="radar-hit-target" />
                  <circle
                    id={`v-${code}`}
                    cx={`${x}`}
                    cy={`${y}`}
                    r="3"
                    fill={dotColor}
                    stroke="white"
                    stroke-width="1"
                    filter="url(#dot-glow-recharts)"
                    class="radar-dot-recharts pointer-events-none"
                  />
                </g>
              ))}

              <!-- Category labels (interactive) -->
              {categoryDimensions.map(({ lx, ly, code, fullName, color, dotColor }) => {
                const isLeft = lx < 50;
                const anchor = lx === 50 ? 'middle' : isLeft ? 'end' : 'start';
                const labelX = lx === 50 ? lx : isLeft ? lx - 3 : lx + 3;
                return (
                  <g
                    class="radar-interactive-target cursor-pointer"
                    data-code={code}
                    data-fullname={fullName}
                    data-color={dotColor}
                    tabindex="0"
                    role="button"
                    aria-label={`Categoría ${code}: ${fullName}`}
                  >
                    <text
                      id={`lbl-code-${code}`}
                      x={`${labelX}`}
                      y={`${ly}`}
                      text-anchor={anchor}
                      fill={color}
                      font-size="4.2"
                      font-weight="800"
                      font-family="Sora, sans-serif"
                      letter-spacing="1.5"
                      class="radar-label-code transition-all duration-200"
                    >
                      {code}
                    </text>
                    <text
                      id={`lbl-name-${code}`}
                      x={`${labelX}`}
                      y={`${ly + 4.5}`}
                      text-anchor={anchor}
                      fill="rgba(0,0,0,0.35)"
                      font-size="2.5"
                      font-weight="500"
                      font-family="Sora, sans-serif"
                      class="radar-label-full transition-all duration-200"
                    >
                      {fullName}
                    </text>
                  </g>
                );
              })}
            </svg>
          </div>
        </div>
      </div>

      <!-- Right: Description + Interactive Badge Grid -->
      <div class="flex-1 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface border border-secondary/20 mb-6 reveal reveal-delay-1 shadow-sm">
          <p class="text-[11px] font-medium text-secondary tracking-widest uppercase">
            METODOLOGÍA CIENTÍFICA
          </p>
        </div>
        <h2 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl text-text mb-6 reveal reveal-delay-1 tracking-tight">
          {locale === 'es' ? '12 categorías ocupacionales' : '12 occupational categories'}
        </h2>
        <p class="text-lg text-text-muted leading-relaxed mb-10 reveal reveal-delay-2 max-w-2xl mx-auto lg:mx-0">
          {locale === 'es'
            ? 'Orient A.KI mapea tus intereses mediante un enfoque estructurado de orientación ocupacional validado profesionalmente. Identificamos tu afinidad en doce categorías ocupacionales para trazar el mapa de tu futuro.'
            : 'Orient A.KI maps your interests using a structured occupational guidance framework. We identify your affinity across twelve occupational categories to chart your future.'}
        </p>

        <!-- Interactive badge grid -->
        <div id="badge-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5 reveal reveal-delay-3" role="group" aria-label={locale === 'es' ? 'Categorías ocupacionales' : 'Occupational categories'}>
          {badgeStyles.map((type) => {
            const cat = categories.find((c) => c.code === type.code);
            return (
              <button
                type="button"
                data-code={type.code}
                data-fullname={cat?.name || type.code}
                data-color={type.dot}
                aria-label={`Categoría ${cat?.name || type.code}`}
                class={`badge-chip flex items-center gap-2 p-2.5 rounded-xl bg-surface border shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-pointer text-left ${type.border}`}
              >
                <span class={`w-2.5 h-2.5 rounded-full flex-shrink-0 ${type.bg} border ${type.border}`} style={`background: ${type.dot}`}></span>
                <span class={`font-display font-bold text-xs tracking-wider ${type.text}`}>{type.code}</span>
              </button>
            );
          })}
        </div>

        <!-- Active category tooltip -->
        <div id="cat-tooltip" class="mt-6 text-center lg:text-left text-sm font-medium text-text-muted min-h-[1.5rem] transition-opacity duration-300 opacity-60">
          {locale === 'es' ? 'Tocá o pasá el cursor sobre el gráfico o una categoría para resaltarla' : 'Tap or hover over the radar or a category to highlight it'}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .radar-dot-recharts {
    transition: r 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.25s ease, stroke-width 0.25s ease;
  }
  .radar-dot-recharts.active {
    r: 5.5;
    stroke-width: 1.5;
    filter: drop-shadow(0 0 8px currentColor);
  }
  .badge-chip.active {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 107, 104, 0.15);
    border-color: var(--color-primary) !important;
  }
  .radar-label-code.active {
    font-size: 5px;
    font-weight: 900;
    filter: drop-shadow(0 0 6px currentColor);
  }
  .radar-label-full.active {
    fill: var(--color-text);
    font-weight: 700;
  }
  .radar-result-animate {
    animation: radar-draw 1.5s cubic-bezier(0.25, 1, 0.5, 1) forwards, radar-fill 1.5s ease-out forwards;
  }
  #radar-card:hover #radar-result {
    stroke-width: 2.2;
    filter: drop-shadow(0 0 10px var(--color-primary));
  }
  @keyframes radar-draw {
    from { stroke-dashoffset: 400; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes radar-fill {
    from { fill-opacity: 0; }
    to { fill-opacity: 1; }
  }
  @keyframes dot-pop {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  const radarCard = document.getElementById('radar-card');
  const svgWrapper = document.querySelector('.radar-svg-wrapper') as HTMLElement | null;
  const tooltip = document.getElementById('cat-tooltip');
  const chips = document.querySelectorAll<HTMLButtonElement>('.badge-chip');
  const interactiveTargets = document.querySelectorAll<SVGGElement>('.radar-interactive-target');
  const floatingInfo = document.getElementById('radar-floating-info');
  const infoDot = document.getElementById('radar-info-dot');
  const infoCode = document.getElementById('radar-info-code');
  const infoName = document.getElementById('radar-info-name');

  const defaultTooltipText = tooltip?.textContent || '';
  let activeCode: string | null = null;

  // Scroll-triggered radar animation
  const radarObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && svgWrapper) {
        svgWrapper.style.transform = 'scale(1)';
        svgWrapper.style.opacity = '1';
        const poly = document.getElementById('radar-result');
        if (poly) poly.classList.add('radar-result-animate');
        
        document.querySelectorAll('.radar-dot-recharts').forEach((dot, i) => {
          (dot as HTMLElement).style.animationDelay = `${0.5 + (i * 0.05)}s`;
          dot.classList.add('radar-dot-animate');
        });
        
        radarObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });
  if (radarCard) radarObserver.observe(radarCard);

  function highlight(code: string, fullName: string, color: string, isPermanentToggle = false) {
    if (isPermanentToggle && activeCode === code) {
      activeCode = null;
      clearHighlight();
      return;
    }

    if (isPermanentToggle) {
      activeCode = code;
    }

    // Update chips
    chips.forEach(c => {
      if (c.dataset.code === code) {
        c.classList.add('active');
      } else {
        c.classList.remove('active');
      }
    });

    // Update dots
    document.querySelectorAll('.radar-dot-recharts').forEach((v) => {
      if (v.id === `v-${code}`) {
        v.classList.add('active');
      } else {
        v.classList.remove('active');
      }
    });

    // Update labels
    document.querySelectorAll('.radar-label-code').forEach((lbl) => {
      if (lbl.id === `lbl-code-${code}`) {
        lbl.classList.add('active');
      } else {
        lbl.classList.remove('active');
      }
    });
    document.querySelectorAll('.radar-label-full').forEach((lbl) => {
      if (lbl.id === `lbl-name-${code}`) {
        lbl.classList.add('active');
      } else {
        lbl.classList.remove('active');
      }
    });

    // Floating overlay inside the radar card
    if (floatingInfo && infoDot && infoCode && infoName) {
      infoDot.style.backgroundColor = color;
      infoCode.textContent = code;
      infoName.textContent = fullName;
      floatingInfo.classList.remove('opacity-0', 'translate-y-1');
      floatingInfo.classList.add('opacity-100', 'translate-y-0');
    }

    // Bottom tooltip update
    if (tooltip) {
      tooltip.textContent = `${code}: ${fullName}`;
      tooltip.style.opacity = '1';
    }
  }

  function clearHighlight() {
    if (activeCode) return; // Retain active selection if locked by click

    chips.forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.radar-dot-recharts').forEach((v) => v.classList.remove('active'));
    document.querySelectorAll('.radar-label-code').forEach((lbl) => lbl.classList.remove('active'));
    document.querySelectorAll('.radar-label-full').forEach((lbl) => lbl.classList.remove('active'));

    if (floatingInfo) {
      floatingInfo.classList.add('opacity-0', 'translate-y-1');
      floatingInfo.classList.remove('opacity-100', 'translate-y-0');
    }

    if (tooltip) {
      tooltip.textContent = defaultTooltipText;
      tooltip.style.opacity = '0.6';
    }
  }

  // Bind right-column badge chips
  chips.forEach((chip) => {
    const code = chip.dataset.code || '';
    const fullName = chip.dataset.fullname || code;
    const color = chip.dataset.color || '#0f6b68';

    chip.addEventListener('click', () => highlight(code, fullName, color, true));
    chip.addEventListener('mouseenter', () => highlight(code, fullName, color, false));
    chip.addEventListener('mouseleave', clearHighlight);
  });

  // Bind SVG interactive vertices and labels
  interactiveTargets.forEach((target) => {
    const code = target.dataset.code || '';
    const fullName = target.dataset.fullname || code;
    const color = target.dataset.color || '#0f6b68';

    target.addEventListener('click', () => highlight(code, fullName, color, true));
    target.addEventListener('mouseenter', () => highlight(code, fullName, color, false));
    target.addEventListener('mouseleave', clearHighlight);

    // Accessibility: support Enter/Space key navigation
    target.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        highlight(code, fullName, color, true);
      }
    });
  });

  // Standard reveal observer for other elements
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
</script>