{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum by (route) (rate(akit_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}],
      "title": "HTTP requests per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(akit_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(akit_http_requests_total[5m])), 1)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "HTTP 5xx ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(akit_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP request p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [
        {"expr": "akit_postgres_up", "legendFormat": "PostgreSQL", "refId": "A"},
        {"expr": "akit_redis_up", "legendFormat": "Redis", "refId": "B"}
      ],
      "title": "Dependency probes (1 = up)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 5,
      "targets": [{"expr": "akit_queue_oldest_waiting_age_seconds{queue!=\"\"}", "legendFormat": "{{queue}}", "refId": "A"}],
      "title": "Oldest waiting queue job",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 6,
      "targets": [{"expr": "akit_queue_failed{queue!=\"\"}", "legendFormat": "{{queue}}", "refId": "A"}],
      "title": "Failed queue jobs",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "akit-local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "id": 7,
      "targets": [{"expr": "sum by (transition) (rate(akit_domain_transitions_total[5m]))", "legendFormat": "{{transition}}", "refId": "A"}],
      "title": "Persisted domain transitions",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["akit", "local", "observability"],
  "time": {"from": "now-1h", "to": "now"},
  "title": "A.kit Local Observability",
  "uid": "akit-local-observability",
  "version": 1
}
