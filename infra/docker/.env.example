# Crear copiando a .env para uso local
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_password
POSTGRES_DB=akit_db

# Local S3-compatible storage (SeaweedFS). These are development-only credentials.
SEAWEEDFS_ACCESS_KEY=akit_local
SEAWEEDFS_SECRET_KEY=akit_local_seaweedfs_password
SEAWEEDFS_REPORTS_BUCKET=akit-private-reports
SEAWEEDFS_DB_BACKUPS_BUCKET=akit-db-backups
